  "correction": {
    "id": "corr_47d6fe35",
    "reason": "GMV 仅统计 status='paid' 的订单（口径 cal:gmv.paid）；city 在 users 表，必须 JOIN users；时间用 created_at 过滤上月",
    "correct_sql": "SELECT u.city, SUM(o.amount) AS gmv FROM orders o JOIN users u ON o.user_id = u.id WHERE o.status = 'paid' AND o.created_at >= date_trunc('month', now()) - interval '1 month' GROUP BY u.city ORDER BY gmv DESC"
  },
